# RAILOPT AI — Environment Configuration
# Copy this file to .env and fill in your values

# Database (PostgreSQL for Docker, SQLite for local dev)
DATABASE_URL=postgresql://railopt:railopt2026@localhost:5432/railopt
# DATABASE_URL=sqlite:///./railopt.db

# Authentication
JWT_SECRET=railopt-sih2026-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo Mode (auto-seeds demo data on startup)
DEMO_MODE=true

# Weather API (optional — uses synthetic data if not set)
OPENWEATHER_API_KEY=

# Application
APP_NAME=RAILOPT AI
APP_VERSION=1.0.0
LOG_LEVEL=INFO
